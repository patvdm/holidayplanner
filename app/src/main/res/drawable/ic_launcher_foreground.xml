<!--
  A map pin with the centre cut out, so the background shows through the hole.

  Everything sits inside the central 72dp safe zone of the 108dp canvas, which is the most any
  launcher mask can crop to. evenOdd is what makes the hole a hole rather than a filled circle that
  would have to be colour-matched to the background.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="M54,26
            C43.51,26 35,34.51 35,45
            C35,59.25 54,83 54,83
            C54,83 73,59.25 73,45
            C73,34.51 64.49,26 54,26 Z
            M54,36
            A9,9 0 1,0 54,54
            A9,9 0 1,0 54,36 Z" />
</vector>
